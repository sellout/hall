{-| Compare two [PVP](https://pvp.haskell.org/)-compliant version numbers.

__FIXME__: This doesn’t yet compare any additional components.
-}
let P =
      https://prelude.dhall-lang.org/v20.1.0/package.dhall
        sha256:26b0ef498663d269e4dc6a82b0ee289ec565d683ef4c00d0ebdd25333a5a3c98

let Version = ./Version

let lessThanEqual =
      λ(x : Version) →
      λ(y : Version) →
            P.Natural.lessThan x.major.a y.major.a
        ||      P.Natural.equal x.major.a y.major.a
            &&  (     P.Natural.lessThan x.major.b y.major.b
                  ||      P.Natural.equal x.major.b y.major.b
                      &&  (     P.Natural.lessThan x.minor y.minor
                            ||  P.Natural.equal x.minor y.minor && True
                          )
                )

let v = ./v

let checkComponents =
      assert : lessThanEqual (v [ 9, 6, 1 ]) (v [ 10, 0, 0 ]) ≡ True

let checkComponentsReversed =
      assert : lessThanEqual (v [ 10, 0, 0 ]) (v [ 9, 6, 1 ]) ≡ False

let checkAdditionalSame =
      assert : lessThanEqual (v [ 9, 6, 1, 1 ]) (v [ 9, 6, 1, 1 ]) ≡ True

let checkAdditionalLess =
      assert : lessThanEqual (v [ 9, 6, 1, 1 ]) (v [ 9, 6, 1, 2 ]) ≡ True

let checkAdditionalGreater =
      assert : lessThanEqual (v [ 9, 6, 1, 2 ]) (v [ 9, 6, 1, 1 ]) ≡ False

let checkPrefix =
      assert : lessThanEqual (v [ 9, 6, 1 ]) (v [ 9, 6, 1, 0 ]) ≡ True

let checkExtension =
      assert : lessThanEqual (v [ 9, 6, 1, 0 ]) (v [ 9, 6, 1 ]) ≡ False

let checkDifferentLengths =
      assert : lessThanEqual (v [ 9, 6, 1, 1, 5 ]) (v [ 9, 6, 1, 2 ]) ≡ True

let checkDifferentLengthsReversed =
      assert : lessThanEqual (v [ 9, 6, 1, 2 ]) (v [ 9, 6, 1, 1, 5 ]) ≡ False

in  lessThanEqual
